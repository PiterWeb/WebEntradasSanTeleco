---
import MainLayout from "../layouts/MainLayout.astro"

---

<MainLayout>
    <div class="max-w-md mx-auto text-center">
      <svg id="party" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce mx-auto size-24 text-indigo-600 lucide lucide-party-popper-icon lucide-party-popper"><path d="M5.8 11.3 2 22l10.7-3.79"/><path d="M4 3h.01"/><path d="M22 8h.01"/><path d="M15 2h.01"/><path d="M22 20h.01"/><path d="m22 2-2.24.75a2.9 2.9 0 0 0-1.96 3.12c.1.86-.57 1.63-1.45 1.63h-.38c-.86 0-1.6.6-1.76 1.44L14 10"/><path d="m22 13-.82-.33c-.86-.34-1.82.2-1.98 1.11c-.11.7-.72 1.22-1.43 1.22H17"/><path d="m11 2 .33.82c.34.86-.2 1.82-1.11 1.98C9.52 4.9 9 5.52 9 6.23V7"/><path d="M11 13c1.93 1.93 2.83 4.17 2 5-.83.83-3.07-.07-5-2-1.93-1.93-2.83-4.17-2-5 .83-.83 3.07.07 5 2Z"/></svg>
    
      <h2 class="mt-6 text-2xl font-bold text-white">Ya has reservado</h2>
    
      <p class="mt-4 text-pretty text-gray-200">
        Ahora comprueba tu correo electrónico para ver si ha llegado el justificante y
        <strong class="text-indigo-600"> 
            abre el enlace para que confirmemos la reserva  
        </strong>
      </p>
    
      <div class="mt-6 space-y-2">
        <a href="/" class="block w-full rounded-lg border px-6 py-3 text-sm font-medium transition-colors border-gray-800 text-white hover:bg-gray-800">
            Ir a la página principal
        </a>
      </div>
    </div>
</MainLayout>